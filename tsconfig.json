{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@presentation/*": ["./src/presentation/*"],
      "@application/*": ["./src/application/*"],
      "@persistence/*": ["./src/persistence/*"],
      "@domain/*": ["./src/domain/*"]
    }
  }
}
