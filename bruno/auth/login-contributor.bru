meta {
  name: Login - contributor
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "contributor@topspot.dev",
    "password": "contributor-demo-pwd"
  }
}

script:post-response {
  if (res.body.success) {
    bru.setEnvVar("contributorAccessToken", res.body.data.accessToken);
  }
}
