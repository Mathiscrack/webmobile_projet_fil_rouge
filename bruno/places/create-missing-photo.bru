meta {
  name: Create place - missing photo
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/places
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{contributorAccessToken}}
}

body:multipart-form {
  name: Spot sans photo
  latitude: 48.69
  longitude: 6.18
  categoryId: 1
  hasWifi: true
  hasPowerOutlets: false
  noiseLevel: quiet
}
