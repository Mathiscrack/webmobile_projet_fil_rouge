# Copier ce fichier en .env avant le premier lancement.

# "mariadb" = nom du service Docker Compose, résolu par le réseau interne de
# Compose. Remplacez-le par "localhost" pour lancer `bun run dev` sans Docker,
# contre l'instance MariaDB exposée sur le port 3306 de la machine hôte.
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=topspot
DB_USER=topspot
DB_PASSWORD=topspot
DB_ROOT_PASSWORD=root

# Secret de signature des tokens JWT : à remplacer par une valeur longue et
# aléatoire, jamais versionnée.
JWT_SECRET=change-me

NODE_ENV=development

# Dossier de stockage des photos dans le conteneur ("uploads", monté comme
# volume Docker nommé pour survivre à une reconstruction du conteneur).
UPLOAD_DIR=/app/uploads
